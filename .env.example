# ================================================================
# DIOGO STUDIO CRM — CONFIGURAÇÃO DE AMBIENTE E PRODUÇÃO
# ================================================================

# 1. AUTENTICAÇÃO E CONTA PRIVADA DE DIOGO
# Se definidas, estas credenciais são sincronizadas automaticamente na base de dados.
DIOGO_USER=diogo
DIOGO_PASSWORD=DiogoStudio2026!

# 2. CHAVE DE SEGURANÇA JWT (Recomendado alterar para uma sequência aleatória forte)
JWT_SECRET_KEY=diogo_studio_haute_atelier_secret_jwt_key_2026

# 3. PERSISTÊNCIA DEFINITIVA NA NUVEM — TURSO CLOUD SQLITE
# Cria a tua base de dados gratuita em https://turso.tech em 1 minuto.
# Exemplo de comandos Turso CLI:
#   turso db create diogo-studio-crm
#   turso db show diogo-studio-crm --url (colar em TURSO_DATABASE_URL)
#   turso db tokens create diogo-studio-crm (colar em TURSO_AUTH_TOKEN)
#
# Se não preenchido, o CRM funcionará automaticamente com o SQLite local (fotografia.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 4. CONFIGURAÇÃO DE DISCO PERSISTENTE (Caso uses o Render Starter Plan com Disco)
# DB_PATH=/var/data/fotografia.db

# 5. DISPARO DE CAMPANHAS & NEWSLETTER (Opcional - Brevo, Resend ou SMTP)
# Brevo (antigo Sendinblue - 300 e-mails/dia grátis):
BREVO_API_KEY=
# Ou Resend (100 e-mails/dia grátis):
# RESEND_API_KEY=
# Ou Servidor SMTP próprio:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contacto@diogostudio.com
# SMTP_PASS=palavra-passe-de-app

# Remetente dos E-mails:
MAIL_FROM=Diogo Studio <contacto@diogostudio.com>
